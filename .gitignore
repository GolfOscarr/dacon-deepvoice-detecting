# os
.DS_Store

# omc
.omc/

# Slurm job logs. `scripts/train.sbatch` defaults --output to the submit
# directory, which is the checkout, so these land here rather than in the run
# directory -- a job's log has to exist before the job knows where --out is.
slurm-*.out

# EDA outputs are derived from the corpus, not source. `eda probe` regenerates
# them; `docs/EDA/00` section 1 describes the layout. The corpus itself lives
# outside the repo (/data/project/private/dacon-corpus).
eda/out/

# training outputs (symlinks into /data/project/private/dacon-runs, Slurm logs) and agent worktrees
/runs/
/.claude/worktrees/
