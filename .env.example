# ---------------------------------------------------------------------------
# Template. Copy to .env and fill in. .env is gitignored; this file is not.
# ---------------------------------------------------------------------------

# Kaggle API -- https://www.kaggle.com/settings/api -> "Generate New Token"
# Kaggle CLI >= 2.2 uses a SINGLE token (starts with "KG..."), not the old
# username/key pair. This is the variable the CLI actually reads.
KAGGLE_API_TOKEN=
# Legacy pair (kaggle.json style). Only needed for older CLI/library versions.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Hugging Face -- https://huggingface.co/settings/tokens  (read token is enough
# for downloading gated model weights / datasets)
HF_TOKEN=
